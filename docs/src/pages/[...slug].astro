---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Example from '../components/Example.astro';
import DocsLayout from '../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id === 'overview' ? undefined : guide.id },
    props: { guide },
  }));
}

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);
---

<DocsLayout description={guide.data.description} headings={headings} title={guide.data.title}>
  <h1 class="text-4xl font-bold">{guide.id === 'overview' ? '@ksojecki/ui' : guide.data.title}</h1>
  <p class="mt-3 text-lg text-(--ink-muted)">{guide.data.description}</p>
  <article class="docs-prose mt-8">
    <Content components={{ Example }} />
  </article>
</DocsLayout>
