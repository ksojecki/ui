---
import { Code } from 'astro:components';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Example from '../../components/Example.astro';
import PropsTable from '../../components/PropsTable.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { GROUPS } from '../../lib/groups';
import { componentDoc } from '../../lib/props';
import { REPOSITORY_URL } from '../../lib/paths';

export async function getStaticPaths() {
  const pages = await getCollection('components');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

interface Props {
  page: CollectionEntry<'components'>;
}

const { page } = Astro.props;
const { title, description, group, components } = page.data;
const { Content, headings } = await render(page);
const groupLabel = GROUPS.find((entry) => entry.id === group)?.label;
const importCode = `import { ${components.join(', ')} } from '@ksojecki/ui/${group}';`;
const propsHeadings = [
  { depth: 2, slug: 'props', text: 'Props' },
  ...(components.length > 1
    ? components.map((name) => ({ depth: 3, slug: `props-${name.toLowerCase()}`, text: name }))
    : []),
];
const sourceFile = componentDoc(components[0]).file;
---

<DocsLayout description={description} headings={[...headings, ...propsHeadings]} title={title}>
  <p class="text-sm font-semibold text-(--ink-muted)">{groupLabel}</p>
  <h1 class="mt-1 text-4xl font-bold">{title}</h1>
  <p class="mt-3 text-lg text-(--ink-muted)">{description}</p>
  <div class="mt-6 flex flex-wrap items-center gap-3 text-sm">
    <div class="docs-import min-w-0 flex-1 overflow-hidden rounded-box border border-(--paper-border)">
      <Code code={importCode} lang="tsx" themes={{ light: 'github-light', dark: 'github-dark' }} />
    </div>
    <a class="btn btn-sm btn-default" href={`${REPOSITORY_URL}/blob/main/${sourceFile}`}>Source</a>
  </div>
  <article class="docs-prose mt-8">
    <Content components={{ Example }} />
    <h2 id="props">Props</h2>
    {
      components.map((name) => (
        <section>
          {components.length > 1 && <h3 id={`props-${name.toLowerCase()}`}>{name}</h3>}
          <PropsTable of={name} />
        </section>
      ))
    }
  </article>
</DocsLayout>
