---
import type { NavSection } from '../lib/nav';
import { docsHref, isCurrent } from '../lib/paths';

interface Props {
  sections: NavSection[];
  class?: string;
}

const { sections, class: className } = Astro.props;
const pathname = Astro.url.pathname;
---

<nav aria-label="Documentation" class={className}>
  {
    sections.map((section) => (
      <div class="mb-5">
        <p class="px-2 text-xs font-bold tracking-wide text-(--ink-muted) uppercase">
          {section.label}
        </p>
        <ul class="mt-1">
          {section.items.map((item) => (
            <li>
              <a
                aria-current={isCurrent(item.path, pathname) ? 'page' : undefined}
                class="docs-nav-link block rounded-field px-2 py-1 text-sm hover:bg-base-200"
                href={docsHref(item.path)}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>
